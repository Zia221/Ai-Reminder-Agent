APP_NAME="AI Reminder Agent API"
ENVIRONMENT=development

# PostgreSQL database. Create this database and user before running Alembic.
DATABASE_URL=postgresql+psycopg://reminder_app:replace_me@localhost:5433/ai_reminder_agent

# Use a random secret of at least 32 characters. Do not commit backend/.env.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional AI features: reminder parsing, assistant, mentor, smart planning, report summary.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Enable the local background scheduler.
REMINDER_SCHEDULER_ENABLED=true

# Optional Gmail SMTP email notifications. For Gmail, use an App Password,
# not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Comma-separated origins allowed to access the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
